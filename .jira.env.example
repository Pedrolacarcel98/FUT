# Plantilla de credenciales para /assess-jira (scripts/assess_to_jira.py).
# COPIA este fichero a .jira.env y rellena tus valores. .jira.env está gitignored: NUNCA se versiona.
#   cp .jira.env.example .jira.env      (luego edítalo)
# El script carga .jira.env automáticamente al hacer --push si estas variables no están ya en el entorno.
# El API token se genera en https://id.atlassian.com/manage-profile/security/api-tokens
#
# IMPORTANTE: no pongas credenciales reales AQUÍ (este fichero se versiona). Van en .jira.env.

JIRA_EMAIL=tu-email@dominio
JIRA_API_TOKEN=pega-aqui-tu-api-token
